#include "win32res.h"

IDI_APPICON       ICON         "descent3mastered_256.ico"
IDI_APPICONSMALL  ICON         "descent3mastered_32.ico"

1 VERSIONINFO
 FILEVERSION 0,9,0,1
 PRODUCTVERSION 0,9,0,1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x2L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Descent 3MASTERED"
            VALUE "FileVersion", "0.9.0 Pre-1"
            VALUE "InternalName", "Descent 3MASTERED"
            VALUE "LegalCopyright", "Descent 3 source Copyright (C) Parallax Software; Descent 3MASTERED changes Copyright (C) 2026 Jeff Graw and contributors"
            VALUE "OriginalFilename", "Descent 3MASTERED.exe"
            VALUE "ProductName", "Descent 3MASTERED"
            VALUE "ProductVersion", "0.9.0 Pre-1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
